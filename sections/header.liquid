<header>
  <button type="button" class="header__menu-toggle" aria-label="Menu" aria-expanded="false" data-menu-toggle>
    <span></span>
    <span></span>
  </button>

  <a href="{{ routes.root_url }}" class="header__logo">
    {{ shop.name }}
  </a>

  <nav class="header__menu" data-header-menu>
    <a href="{{ routes.root_url }}">Home</a>
    <a href="{{ routes.all_products_collection_url }}">Shop All</a>
    <a href="{{ pages.about.url | default: '/pages/about' }}">About</a>
    <a href="{{ pages.team.url | default: '/pages/team' }}">Team</a>
    <a href="{{ pages.teampack.url | default: '/pages/teampack' }}">Teampack</a>
  </nav>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}" class="header__account">
        Account
      </shopify-account>
    {% endif %}

    <button type="button" class="header__search" aria-label="Search">
      {{ 'icon-search.svg' | inline_asset_content }}
    </button>

    <a href="{{ routes.cart_url }}" class="header__cart">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    position: relative;
    width: 100%;
    height: 100px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-foreground);
    padding: 0 var(--page-margin);
  }
  header .header__menu-toggle {
    display: none;
    justify-self: start;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 2rem;
    height: 2rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  header .header__menu-toggle span {
    display: block;
    width: 100%;
    height: 1px;
    background-color: var(--color-foreground);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  header .header__menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  header .header__menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  header .header__logo {
    justify-self: start;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-header--family);
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1.1;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: 1px solid var(--color-foreground);
    width: 3rem;
    height: 3rem;
  }
  header .header__menu {
    justify-self: center;
    display: flex;
    gap: 2rem;
  }
  header .header__menu a {
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-header--family);
    font-weight: 500;
    font-size: 32px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  header .header__icons {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  header .header__account {
    cursor: pointer;
    text-decoration: none;
    color: var(--color-foreground);
    font-family: var(--font-header--family);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  header .header__search {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
  }
  header a {
    position: relative;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 1.5rem;
  }

  @media (max-width: 62rem) {
    header {
      grid-template-columns: auto 1fr auto;
    }
    header .header__menu-toggle {
      display: flex;
    }
    header .header__logo {
      justify-self: center;
    }
    header .header__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background-color: var(--color-background);
      border-bottom: 1px solid var(--color-foreground);
      padding: 1rem var(--page-margin) 1.5rem;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s;
    }
    header .header__menu[data-open] {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    header .header__menu a {
      width: 100%;
      padding: 0.75rem 0;
      font-size: 1.25rem;
    }
    header .header__account {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-menu-toggle]').forEach(function (toggle) {
    var header = toggle.closest('header');
    var menu = header.querySelector('[data-header-menu]');
    if (!menu) return;

    toggle.addEventListener('click', function () {
      var isOpen = menu.hasAttribute('data-open');
      if (isOpen) {
        menu.removeAttribute('data-open');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        menu.setAttribute('data-open', '');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
